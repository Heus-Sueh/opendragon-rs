# OpenDragon Udev Rules for Redragon Peripherals
# Grants non-root desktop access to Redragon HID and USB configuration nodes.
#
# Installation:
#   sudo cp udev/70-opendragon.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# Microdia / Sonix (Kumara Pro K552RGB-PRO, Mitra K551, Kumara K552, EVision)
KERNEL=="hidraw*", ATTRS{idVendor}=="0c45", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0c45", MODE="0666", TAG+="uaccess"

# Holtek Semiconductor (M607 Griffin, M909 Emperor, M601-3 Centrophorus)
KERNEL=="hidraw*", ATTRS{idVendor}=="04d9", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="04d9", MODE="0666", TAG+="uaccess"

# ACRUX (Redragon 2.4G Wireless Receivers and Dongles)
KERNEL=="hidraw*", ATTRS{idVendor}=="1a34", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1a34", MODE="0666", TAG+="uaccess"

# SinoWealth (Redragon Keyboards and Mice)
KERNEL=="hidraw*", ATTRS{idVendor}=="258a", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="258a", MODE="0666", TAG+="uaccess"

# Redragon Native / EVision
KERNEL=="hidraw*", ATTRS{idVendor}=="320f", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="320f", MODE="0666", TAG+="uaccess"

